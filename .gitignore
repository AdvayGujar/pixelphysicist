# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Env / secrets - never commit keys
.env
.env.*

# Runs, results, data (large / generated)
runs/
results/*.csv
results/*.json
data/clips/*
data/synthetic/*
!data/clips/.gitkeep
!data/synthetic/.gitkeep

# Local-only docs (planning notes, failure log, API transcripts) - never commit
plan.md
plan-v1.md
response.md
docs/FAILURES.md

# Media
*.mp4
*.mov

# OS / editor
.DS_Store
.idea/
.vscode/
