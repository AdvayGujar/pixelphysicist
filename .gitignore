# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Env / secrets - never commit keys
.env
!.env.example

# Runs, results, data (large / generated)
runs/
results/*.csv
results/*.json
!results/baseline.json
!results/day4.json
data/clips/*
data/synthetic/*
!data/clips/.gitkeep
!data/clips/notes.md
!data/synthetic/.gitkeep

# Local-only docs (planning notes, failure log, API transcripts) - never commit
plan.md
plan-v1.md
response.md
docs/FAILURES.md

# Media
*.mp4
*.mov
!tests/fixtures/*.mp4

# OS / editor
.DS_Store
.idea/
.vscode/
